#!/usr/bin/env python

import argparse
import pathlib
import subprocess
import re
import urllib.parse
import warnings
import webbrowser
from collections.abc import Iterable, Sequence, Generator
from typing import Any

RED = "\033[0;31m"
GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
BLUE = "\033[0;34m"
MAGENTA = "\033[0;35m"
CYAN = "\033[0;36m"
GREY = "\033[38;5;240m"
BOLD = "\033[1m"
RESET = "\033[0m"

DEFAULT_BRANCH_NAMES = ["main", "master"]


def colour(text: str, colour_: str) -> str:
    """
    Return the text in the given colour.
    """

    return f"{colour_}{text}{RESET}"


def _run_git_cmd(
    args: Iterable[str],
    git_dir: pathlib.Path | None = None,
    print_cmd: bool = False,
) -> Generator[str]:
    cmds = ("git",) if git_dir is None else ("git", "-C", git_dir)
    if print_cmd:
        print(colour(" ".join([*cmds, *args]), BLUE + BOLD))

    # https://stackoverflow.com/a/4417735
    popen = subprocess.Popen(
        args=(*cmds, *args),
        stdout=subprocess.PIPE,
        universal_newlines=True,
    )
    if popen.stdout:
        for line in popen.stdout:
            yield line.rstrip("\n")
    if popen.stderr:
        for line in popen.stderr:
            yield line.rstrip("\n")

    popen.wait()
    if popen.returncode != 0:
        raise RuntimeError("git push returned a non-zero exit code")


def _get_branch_name() -> str:
    return next(_run_git_cmd(("branch", "--show-current")))


def _get_default_branch() -> str:
    """
    Return the default branch for the current repository.

    `git show-branch` shows the branches and across branches, for example:

        * [bar] feat: and one more thing
         ! [foo] feat: another thing
          ! [main] Initial commit
        ---
        *   [bar] feat: and one more thing
        *+  [foo] feat: another thing
        *+  [foo^] feat: something else
        *+  [foo~2] feat: something
        *++ [main] Initial commit

    We just take the final line and parse the name out of it.
    """

    # TODO: Can we do something with:
    #       git name-rev --name-only $(git show-branch --merge-base)

    branch_lines = filter(lambda s: s.strip(), _run_git_cmd(("show-branch",)))
    line = list(branch_lines)[-1]
    match = re.search(r"\[([a-zA-Z0-9-]+)]", line)
    assert match is not None, f"could not find branch name in line: {line}"

    return match.group(1)


def _get_remote_url() -> str:
    origin_name = "origin"
    return "\n".join(
        _run_git_cmd(
            ("remote", "get-url", origin_name),
            print_cmd=False,
        )
    )


def _ssh_to_http(ssh_url: str) -> str:
    ssh_pattern = r"git@([\w.]+):([\w-]+)/([\w-]+)"
    matches = re.compile(ssh_pattern).findall(ssh_url)
    if not matches:
        raise ValueError(
            f"Could not handle SSH remote with URL '{ssh_url}'. Expected URL with pattern '{ssh_pattern}'"
        )

    host, owner, repo = matches[0]
    return f"https://{host}/{owner}/{repo}"


def _github_pull_request_url(host_url: str, branch_name: str) -> str:
    return f"{host_url}/pull/new/{branch_name}"


def _github_pull_request_url_with_params(
    host_url: str,
    branch_name: str,
    parameters: dict[str, str],
) -> str:
    """
    https://docs.github.com/en/pull-requests/reference/using-query-parameters-to-create-a-pull-request
    """
    # This isn't the "preferred" route since we have to guess the base
    # branch name, but that's required for the URL to support params

    def _parse(value: Any) -> Any:
        if isinstance(value, list):
            return ",".join(value)
        else:
            return value

    params = urllib.parse.urlencode(
        {"quick_pull": 1} | {k: _parse(v) for k, v in parameters.items()},
        safe=",",
    )

    # Assume we always want to merge back to the base branch, not any
    # intermediate branches (e.g. `main` -> `foo` -> `bar` would merge `bar`
    # into `main`)
    base_branch = _get_default_branch()
    if base_branch not in DEFAULT_BRANCH_NAMES:
        warnings.warn(
            f"'{base_branch}' detected as default branch, which is not one of {DEFAULT_BRANCH_NAMES}",
            stacklevel=1,
        )

    return f"{host_url}/compare/{base_branch}...{branch_name}?{params}"


def _parse_values(key: str, values: list) -> tuple[str, Any]:
    if len(values) == 0:
        if key.startswith("no-"):
            return key[3:], False
        else:
            return key, True
    elif len(values) == 1:
        return key, values[0]
    else:
        return key, values


def collect_unknown_args(args: list[str]) -> dict[str, str]:
    if not args:
        return {}

    if not args[0].startswith("--"):
        raise ValueError(f"could not parse unknown args: first argument must be a flag, not a value")

    key, values = None, []
    result = dict()
    for item in args:
        if item == "--":
            raise ValueError("'--' is unsupported")
        if item.startswith("--"):
            if key is not None:
                k, v = _parse_values(key, values)
                result[k] = v

            key = item[2:]
            values = []
        else:
            assert key is not None
            values.append(item)

    assert key is not None
    k, v = _parse_values(key, values)
    result[k] = v

    return result


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--push",
        action=argparse.BooleanOptionalAction,
        default=False,
    )
    args, unknown_args = parser.parse_known_args(argv)

    remote_url = _get_remote_url()
    if remote_url.startswith("git@"):
        try:
            http_url = _ssh_to_http(remote_url)
        except ValueError as e:
            print(colour(f"error: {e}", RED))
            return 1
    else:
        http_url = remote_url

    branch_name = _get_branch_name()
    if http_url.startswith("https://github.com"):
        if unknown_args:
            pull_request_url = _github_pull_request_url_with_params(
                http_url,
                branch_name,
                parameters=collect_unknown_args(unknown_args),
            )
        else:
            pull_request_url = _github_pull_request_url(http_url, branch_name)
    else:
        raise NotImplementedError(f"Method not supported for {http_url}")

    if args.push:
        if branch_name in DEFAULT_BRANCH_NAMES:
            # not gonna bother implementing something like `--force` -- if the
            # branch needs to be pushed, just use `git push` directly
            print(colour(f"error: pushes to the default branch are prohibited", RED))
            return 1
        try:
            for line in _run_git_cmd(("push",), print_cmd=True):
                print(line)
        except RuntimeError:
            return 1

    print(colour(f"Opening PR at: {pull_request_url}", GREEN))
    webbrowser.open(pull_request_url)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
